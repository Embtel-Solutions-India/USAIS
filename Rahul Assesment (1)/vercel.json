{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/includes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    { "source": "/usais-website",             "destination": "/",                           "permanent": true },
    { "source": "/usais-website.html",         "destination": "/",                           "permanent": true },
    { "source": "/l1b-visa",                   "destination": "/pages/l1b",                  "permanent": true },
    { "source": "/l1b-visa.html",              "destination": "/pages/l1b",                  "permanent": true },
    { "source": "/eb1c-green-card",            "destination": "/pages/eb1c",                 "permanent": true },
    { "source": "/eb1c-green-card.html",       "destination": "/pages/eb1c",                 "permanent": true },
    { "source": "/business-assessment",        "destination": "/pages/business-assessment",  "permanent": true },
    { "source": "/business-assessment.html",   "destination": "/pages/business-assessment",  "permanent": true },
    { "source": "/us-branch-setup",            "destination": "/pages/us-branch-setup",      "permanent": true },
    { "source": "/us-branch-setup.html",       "destination": "/pages/us-branch-setup",      "permanent": true },
    { "source": "/business-plan-filing",       "destination": "/pages/business-plan-filing", "permanent": true },
    { "source": "/business-plan-filing.html",  "destination": "/pages/business-plan-filing", "permanent": true },
    { "source": "/operational-launch",         "destination": "/pages/operational-launch",   "permanent": true },
    { "source": "/operational-launch.html",    "destination": "/pages/operational-launch",   "permanent": true }
  ]
}
